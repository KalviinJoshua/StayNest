# --- StayNest frontend environment ---
# Copy this file to `.env` (Vite reads it automatically). Only VITE_-prefixed
# vars are exposed to the browser. Do not put secrets here.

# Base URL of the StayNest API (include the /api suffix).
# Local dev:   http://localhost:5000/api
# Production:  https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
